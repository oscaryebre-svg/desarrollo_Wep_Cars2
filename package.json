{
  "name": "games-cars",
  "version": "1.0.0",
  "description": "API REST del catalogo de videojuegos games-cars con Express, TypeScript y TypeORM sobre MariaDB/MySQL.",
  "main": "dist/app.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node src/app.ts",
    "start:prod": "node dist/app.js",
    "dev": "node --watch -r ts-node/register src/app.ts",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "express",
    "typeorm",
    "typescript",
    "mysql",
    "crud",
    "rest"
  ],
  "author": "Desarrollo Web",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "mysql2": "^3.11.5",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.5",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
