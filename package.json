{
  "name": "games-cars",
  "version": "1.0.0",
  "description": "API REST de catálogo de videojuegos/coches con Node.js + Express + MySQL. Incluye CRUD completo, borrado lógico, restauración y búsquedas por nombre/descripción.",
  "main": "src/app.ts",
  "scripts": {
    "start": "ts-node src/app.ts",
    "dev": "node --watch -r ts-node/register src/app.ts"
  },
  "keywords": [
    "express",
    "mysql",
    "crud",
    "rest",
    "catalogo"
  ],
  "author": "Desarrollo Web",
  "license": "MIT",
  "dependencies": {
    "express": "^4.21.2",
    "mysql2": "^3.11.5",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^1.1.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^26.6.5",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  }
}
